msgstr ""

#. module: sale_order_line_qty_policy_ddt
#: model:ir.model.fields,help:sale_order_line_qty_policy_ddt.field_sale_order_line_qty_ddt_declared
msgid "Technical field: the quantity this order line delivered with delivery note lines which were declared invoiced, and which therefore will never produce an invoice line.\n"
"It is counted beside the invoiced quantity, so that the order is not invoiced again for goods a delivery note already settled."
msgstr ""

