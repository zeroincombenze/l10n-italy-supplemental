<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_product_search_line_name" model="ir.ui.view">
        <field name="name">sale.report.search.line.name</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">

            <field name="product_id" position="after">
                <field name="line_name"/>
            </field>

            <filter name="Category" position="after">
                <filter string="Line Description" name="line_name"
                        context="{'group_by':'line_name'}"/>
            </filter>

        </field>
    </record>

    <record id="view_account_invoice_report_search_line_name" model="ir.ui.view">
        <field name="name">account.invoice.report.search.line.name</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">

            <field name="categ_id" position="after">
                <field name="line_name"/>
            </field>

            <filter name="category_product" position="after">
                <filter string="Line Description" name="line_name"
                        context="{'group_by':'line_name'}"/>
            </filter>

        </field>
    </record>

</odoo>
