<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_it_coa_tax_config_form" model="ir.ui.view">
        <field name="name">l10n_it_coa.tax.config.form</field>
        <field name="model">l10n_it_coa.tax.config</field>
        <field name="arch" type="xml">
            <form string="Configure Italian taxes">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="tax_ids" widget="many2many_tags"
                           invisible="result"/>
                    <field name="result" invisible="not result" nolabel="1" colspan="2"/>
                </group>
                <p class="text-muted" invisible="result">
                    Sets tax grids, VAT accounts, cash basis and exemption data of the
                    selected it_coa taxes. With no tax selected all it_coa taxes are
                    configured.
                </p>
                <footer>
                    <button string="Configure" type="object" name="action_configure"
                            class="btn-primary" invisible="result"/>
                    <button string="Close" special="cancel"
                            class="btn-primary" invisible="not result"/>
                    <button string="Cancel" special="cancel" invisible="result"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_it_coa_tax_config_action" model="ir.actions.act_window">
        <field name="name">Configure Italian taxes</field>
        <field name="res_model">l10n_it_coa.tax.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_tax"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>

    <menuitem id="l10n_it_coa_tax_config_menu"
              action="l10n_it_coa_tax_config_action"
              parent="account.account_account_menu"
              sequence="3"
              groups="account.group_account_manager"/>
</odoo>
