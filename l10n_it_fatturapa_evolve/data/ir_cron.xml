<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <record id="validate_sent_einvoice" model="ir.cron">
        <field name="name">Check for delivered e-invoices</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model.verify_all_notifications()</field>
    </record>

    <record id="acquire_all_einvoices" model="ir.cron">
        <field name="name">Check for supplier e-invoices</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model.acquire_all_einvoices()</field>
    </record>

</odoo>
