<?xml version='1.0' encoding='utf-8' ?>
<odoo>

    <record id="view_sdi_channel_form" model="ir.ui.view">
        <field name="name">sdi.channel.inherit.view.form</field>
        <field name="model">sdi.channel</field>
        <field name="inherit_id" ref="l10n_it_sdi_channel.view_sdi_channel_form" />
        <field name="arch" type="xml">
                <xpath expr="//newline" position="after">
                    <group attrs="{'invisible': [('channel_type', '!=', 'evolve')]}">
                        <field name="client_id"
                        attrs="{'required': [('channel_type', '=', 'evolve')]}"
                    />
                         <field name="client_key" password="True"
                        attrs="{'required': [('channel_type', '=', 'evolve')]}"
                    />
                        <field name="client_company_id"
                        attrs="{'required': [('channel_type', '=', 'evolve')]}"
                    />
                        <field name="sender_url"
                        attrs="{'required': [('channel_type', '=', 'evolve')]}"
                    />
                        <field name="exchange_hub"
                        attrs="{'required': [('channel_type', '=', 'evolve')]}"
                    />
                        <field name="archive_sent"/>
                        <field name="archive_out"/>
                        <field name="archive_in"/>
                        <field name="capture_days"/>
                        <field name="last_demand"/>
                    </group>
                </xpath>
        </field>
    </record>
</odoo>
