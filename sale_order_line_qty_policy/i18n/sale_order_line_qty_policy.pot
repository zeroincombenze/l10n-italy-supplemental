#. module: sale_order_line_qty_policy
#: model:ir.model.fields,help:sale_order_line_qty_policy.field_sale_order_force_delivery_state_manual
msgid "Technical field: force_delivery_state was written by a user, so the quantity policy will no more manage it.\n"
"When it is not set, the flag belongs to the quantity policy, which sets and clears it following the delivered quantities. An unknown value therefore never strands the flag: the policy simply takes it back."
msgstr ""

#. module: sale_order_line_qty_policy
#: model:ir.model.fields,help:sale_order_line_qty_policy.field_sale_order_line_line_delivered
msgid "Technical field: the line is delivered, either because the delivered quantity reached the ordered one, or because the deviation is within the product threshold, or because the line was manually declared delivered."
msgstr ""

#. module: sale_order_line_qty_policy
#: model:ir.model.fields,help:sale_order_line_qty_policy.field_sale_order_line_force_delivered
msgid "When set, this line is considered fully delivered even if the delivered quantity is less than the ordered one.\n"
"Delivered quantity is not altered by this flag."
msgstr ""

#. module: sale_order_line_qty_policy
#: model:ir.model.fields,help:sale_order_line_qty_policy.field_sale_order_line_force_invoiced
msgid "When set, this line is considered fully invoiced even if there are ordered or delivered quantities still to invoice; the line is no more selected to create an invoice."
msgstr ""

