<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_inherit_delivery_state" model="ir.ui.view">
        <field name="name">sale.order.form.sale.stock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <button name="action_force_delivery_state" type="object" string="Force delivery done" invisible="state != 'done' or force_delivery_state or delivery_state == 'done'"/>
                <button name="action_unforce_delivery_state" type="object" string="Unforce delivery done" invisible="state != 'done' or not force_delivery_state"/>
            </field>
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="delivery_state" readonly="1"/>
                <field name="force_delivery_state" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_delivery_state" model="ir.ui.view">
        <field name="name">sale.order.list</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <field name="invoice_status" position="after">
                <field name="delivery_state"/>
            </field>
        </field>
    </record>
</odoo>
