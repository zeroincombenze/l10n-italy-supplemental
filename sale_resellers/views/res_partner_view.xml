<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_sale_reseller_form" model="ir.ui.view">
        <field name="name">res.partner.sale.reseller</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
                <xpath expr="//page[@name='sales_purchases']" position="inside">
                    <group>
                        <separator string="Partner Classification" colspan="2"/>
                        <group>
                            <field name="partner_grade" widget="selection" readonly="end_user == True"/>
                        </group>
                        <group>
                            <field name="end_user"/>
                                   <!--  readonly="partner_grade != ''"/> -->
                            <field name="assigned_reseller" domain="[('end_user', '!=',True)]" readonly="end_user != True"/>
                        </group>
                    </group>
                </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_end_user" model="ir.ui.view">
        <field name="name">res.partner.filter.end.user</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
                <filter name="end_user" string="End Users" domain="[('end_user','=',True)]"/>
            </filter>
        </field>
    </record>

</odoo>
