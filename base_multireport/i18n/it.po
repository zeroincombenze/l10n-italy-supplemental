"%(city)s   -> città azienda       %(fatturapa_rea_capital)s\n"
"%(email)s  -> email azienda      %(fatturapa_rea_capital)s\n"
"%(fax)s    -> fax azienda        %(fatturapa_rea_number)s\n"
"%(name)    -> nome azienda       %(fatturapa_rea_office)s\n"
"%(phone)s  -> telefono azienda      %(fiscalcode)s\n"
"%(street)s -> indirizzo azienda     %(ipa_code)s\n"
"%(street2)s-> seconda via azienda    %(mobile)s\n"
"%(vat)s    -> P.IVA azienda\n"
"%(website)s-> sito azienda\n"
"%s(zip)    -> CAP azienda"

