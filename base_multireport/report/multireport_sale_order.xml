<odoo>

    <template id="report_saleorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-set="style"
                    t-value="o.company_id.report_model_style.origin or 'odoo'"
                />
                <t
                    t-if="style == 'odoo_based'"
                    t-call="base_multireport.report_saleorder_document"
                    t-lang="o.partner_id.lang"
                />
                <t
                    t-if="style == 'odoo'"
                    t-call="sale.report_saleorder_document"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="report_sale_order" model="ir.actions.report">
        <field name="name">Preventivo / Ordine (personalizzato)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_multireport.report_saleorder</field>
        <field name="report_file">base_multireport.report_saleorder</field>
    </record>

</odoo>
