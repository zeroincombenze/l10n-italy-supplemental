<odoo>

    <template id="report_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-set="style"
                    t-value="o.company_id.report_model_style.origin or 'odoo'"
                />
                <t
                    t-if="style == 'odoo_based'"
                    t-call="base_multireport.report_invoice_document"
                    t-lang="o.partner_id.lang"
                />
                <t
                    t-if="style == 'odoo'"
                    t-call="account.report_invoice_document"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="account_invoices" model="ir.actions.report">
        <field name="name">Fattura (personalizzata)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_multireport.report_invoice</field>
        <field name="report_file">base_multireport.report_invoice</field>
        <field name="attachment_use">True</field>
        <field name="attachment">(object.state == 'posted') and ('INV'+(object.name or '').replace('/','')+'.pdf')</field>
        <field name="paperformat_id" ref="base_multireport.paperformat_invoice"/>
    </record>

    <template id="account_invoice_report_duplicate_main">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-set="style"
                    t-value="o.company_id.report_model_style.origin or 'odoo'"
                />
                <t
                    t-if="style == 'odoo_based'"
                    t-call="base_multireport.account_invoice_report_duplicate"
                    t-lang="o.partner_id.lang"
                />
                <t
                    t-if="style == 'odoo'"
                    t-call="base_multireport.account_invoice_report_duplicate"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="account_invoice_action_report_duplicate" model="ir.actions.report">
        <field name="name">Ft. di cortesia (personalizzata)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_multireport.account_invoice_report_duplicate_main</field>
        <field name="report_file">base_multireport.account_invoice_report_duplicate_main</field>
        <field name="attachment_use">False</field>
        <field name="paperformat_id" ref="base_multireport.paperformat_invoice"/>
    </record>

    <template id="report_delivery_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-set="style"
                    t-value="o.company_id.report_model_style.origin or 'odoo'"
                />
                <t
                    t-if="style == 'odoo_based'"
                    t-call="base_multireport.report_delivery_invoice_document"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="delivery_invoice_action_report" model="ir.actions.report">
        <field name="name">Fattura di accompagnamento</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_multireport.report_delivery_invoice</field>
        <field name="report_file">base_multireport.report_delivery_invoice</field>
        <field name="attachment_use">True</field>
        <field name="attachment">(object.state == 'posted') and ('INV'+(object.name or '').replace('/','')+'.pdf')</field>
        <field name="paperformat_id" ref="base_multireport.paperformat_invoice"/>
    </record>

</odoo>
