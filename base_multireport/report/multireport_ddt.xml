<odoo>

    <template id="report_ddt_main">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-set="style"
                    t-value="o.company_id.report_model_style.origin or 'odoo'"
                />
                <t
                    t-if="style == 'odoo_based'"
                    t-call="base_multireport.report_ddt"
                    t-lang="o.partner_id.lang"
                />
                <t
                    t-if="style == 'odoo'"
                    t-call="l10n_it_delivery_note.delivery_note_report_template"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="action_report_ddt" model="ir.actions.report">
        <field name="name">DdT (personalizzato)</field>
        <field name="model">stock.delivery.note</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_multireport.report_ddt_main</field>
        <field name="report_file">base_multireport.report_ddt_main</field>
    </record>

</odoo>
