<odoo>

    <template id="report_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                        t-set="style"
                        t-value="o.company_id.report_model_style.origin or 'odoo'"
                />
                <t
                        t-if="style == 'odoo_based'"
                        t-call="base_multireport.report_picking"
                        t-lang="o.partner_id.lang"
                />
                <t
                        t-if="style == 'odoo'"
                        t-call="stock.report_picking"
                        t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="action_report_picking" model="ir.actions.report">
        <field name="name">Ordine di prelievo (personalizzato)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_multireport.report_picking</field>
        <field name="report_file">base_multireport.report_picking_operations</field>
    </record>

    <template id="report_deliveryslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                        t-set="style"
                        t-value="o.company_id.report_model_style.origin or 'odoo'"
                />
                <t
                        t-if="style == 'odoo_based'"
                        t-call="base_multireport.report_delivery_document"
                        t-lang="o.partner_id.lang"
                />
                <t
                        t-if="style == 'odoo'"
                        t-call="stock.report_delivery_document"
                        t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="action_report_delivery" model="ir.actions.report">
        <field name="name">Ordine di consegna (personalizzato)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_multireport.report_deliveryslip</field>
        <field name="report_file">base_multireport.report_deliveryslip</field>
    </record>

</odoo>
