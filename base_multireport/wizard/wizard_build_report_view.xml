<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="wizard_build_report_view" model="ir.ui.view">
        <field name="name">Create or update a report</field>
        <field name="model">wizard.build.report</field>
        <field name="arch" type="xml">
            <form string="Create or update a report">
                <sheet>
                    <group>
                        <field name="make_custom_header" />
                        <field name="make_custom_footer" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="build_report"
                        string="Build"
                        type="object"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_build_report" model="ir.actions.act_window">
        <field name="name">Create or update a report</field>
        <field name="res_model">wizard.build.report</field>
        <field name="target">new</field>
        <field name="view_id" ref="wizard_build_report_view" />
        <field name="view_mode">form</field>
    </record>
</odoo>
