<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="crm_lead_view_area_form" model="ir.ui.view">
        <field name="name">crm.lead.view.area.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_form_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="replace">
                <field name="partner_id"
                       string="Customer"
                       placeholder="Link to customer if exists"
                       options="{&quot;no_create&quot;: True}"/>
            </xpath>
            <field name="partner_name" position="after">
                <field name="area_id"
                       placeholder="Area"
                       options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
            </field>
        </field>
    </record>

    <record id="res_partner_view_area_search" model="ir.ui.view">
        <field name="name">view.customer.area.search</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Area" context="{'group_by': 'area_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
