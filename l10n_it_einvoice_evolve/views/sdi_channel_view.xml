<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_sdi_channel_form" model="ir.ui.view">
        <field name="name">view.sender.form</field>
        <field name="model">sdi.channel</field>
        <field name="inherit_id" ref="l10n_it_sdi_channel.view_sdi_channel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[2]" position="after">
                 <group attrs="{'invisible': [('channel_type', '!=', 'evolve')]}">
                    <field name="client_id" />
                    <field name="client_key" />
                    <field name="sender_url" />
                    <field name="sender_company_id" />
                    <field name="hub_ip_addr" />
                </group>
                <group attrs="{'invisible': [('channel_type', '!=', 'evolve')]}">
                    <field name="param1" />
                    <field name="param2" />
                    <field name="param3" />
                    <field name="param4" />
                    <field name="param5" />
                    <field name="param6" />
                    <field name="active" />
                </group>
                <group attrs="{'invisible': [('channel_type', '!=', 'evolve')]}">
                    <field name="avail_message"/>
                    <field name="max_invoices_ctr"/>
                    <field name="used_invoices_ctr"/>
                    <field name="bonus_invoices_ctr"/>
                    <field name="avail_invoices_ctr"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_available_invoices" model="ir.ui.view">
        <field name="name">view.available.invoices</field>
        <field name="model">sdi.channel</field>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <form string="Result of Account Opening">
                <group>
                    <field name="avail_message"/>
                    <field name="avail_invoices_ctr"/>
                </group>
                <footer>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
