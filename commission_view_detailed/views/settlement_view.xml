<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_settlement_line_tree">
        <field name="name">Settlements tree</field>
        <field name="model">sale.commission.settlement.line</field>
        <field name="inherit_id" ref="sale_commission.view_settlement_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice']" position="after">
                <field name="customer_id" attrs="{'readonly': 1}"/>
            </xpath>
            <xpath expr="//field[@name='commission']" position="after">
                <field name="calculated_commission_rate" attrs="{'readonly': 1}"/>
            </xpath>
        </field>
    </record>

</odoo>