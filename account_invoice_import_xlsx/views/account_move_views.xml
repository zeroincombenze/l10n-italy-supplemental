<odoo>

    <record id="view_move_form_import_xlsx" model="ir.ui.view">
        <field name="name">account.move.import.xlsx</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(account_invoice_import_xlsx.action_import_file)d"
                        type="action" string="Import xlsx"
                        groups="account.group_account_invoice"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

</odoo>
