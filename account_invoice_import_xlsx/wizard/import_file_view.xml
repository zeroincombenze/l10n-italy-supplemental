<odoo>

    <record model="ir.ui.view" id="wizard_invoice_import_file_xlsx">
        <field name="name">Import invoice from file xlsx</field>
        <field name="model">wizard.import.invoice.file.xlsx</field>
        <field name="arch" type="xml">
            <form string="Import invoice from file xlsx">
                <group>
                    <field name="data_file" filename="filename"
                           placeholder="Choose a file to import..."/>
                    <field name="filename" invisible="1"/>
                    <field name="journal_id"
                           invisible="context.get('active_model') == 'account.move'"/>
                    <field name="invoice_date"
                           invisible="context.get('active_model') == 'account.move'"/>
                    <field name="dry_run"/>
                </group>
                <footer>
                    <button string="Import" name="import_file_xlsx"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="wizard_import_invoice_result">
        <field name="name">Import Invoices</field>
        <field name="model">wizard.import.invoice.file.xlsx</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Result of Import invoices">
                <field name="tracelog" nolabel="1"/>
                <footer>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Import lines into the current draft invoice (button on the invoice) -->
    <record id="action_import_file" model="ir.actions.act_window">
        <field name="name">Import invoice from file xlsx</field>
        <field name="res_model">wizard.import.invoice.file.xlsx</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_invoice_import_file_xlsx"/>
        <field name="target">new</field>
    </record>

    <!-- Create whole invoices from a file (menu) -->
    <record id="action_import_account_invoice" model="ir.actions.act_window">
        <field name="name">Import Account Invoice</field>
        <field name="res_model">wizard.import.invoice.file.xlsx</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_invoice_import_file_xlsx"/>
        <field name="target">new</field>
        <field name="context">{'active_model': False, 'active_ids': False}</field>
    </record>

    <menuitem id="menu_account_invoice_import"
              name="Import Account Invoice"
              action="action_import_account_invoice"
              parent="account.menu_finance_configuration"
              sequence="100"/>

</odoo>
